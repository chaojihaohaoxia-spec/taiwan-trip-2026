{
  "_说明": "「怎么去」芯片和写法：transportOf / transportChoices / transportPatch / titleHow / chipOfMode（演示数据）。args 是按顺序传的参数。",
  "fn": "transportPatch",
  "cases": [
    { "name": "原来没写，选打车：写一条 App 的推荐", "args": [{ "id": "i1" }, "taxi"],
      "expect": { "options": [{ "mode": "taxi", "recommended": true, "source": "app" }] } },
    { "name": "原来没写，选自动：null", "args": [{ "id": "i1" }, "auto"], "expect": null },
    { "name": "原来是 App 写的走路，改成地铁：整条换掉", "args": [{ "id": "i1", "transport_in": { "options": [{ "mode": "walk", "recommended": true, "source": "app" }] } }, "metro"],
      "expect": { "options": [{ "mode": "metro", "recommended": true, "source": "app" }] } },
    { "name": "原来是 App 写的，选自动：清掉", "args": [{ "id": "i1", "transport_in": { "options": [{ "mode": "walk", "recommended": true, "source": "app" }] } }, "auto"],
      "expect": null },
    { "name": "空的 options：当没写", "args": [{ "id": "i1", "transport_in": { "options": [] } }, "walk"],
      "expect": { "options": [{ "mode": "walk", "recommended": true, "source": "app" }] } },
    { "name": "导入过的两种（Grab 推荐、打车）：改成打车，推荐挪过去，说明一个字不丢",
      "args": [{ "id": "i1", "transport_in": { "summary": "Grab 约 15 分钟", "options": [{ "mode": "grab", "recommended": true, "duration_min": 15, "note": "机场出口 B 门" }, { "mode": "taxi", "cost": { "amount": 200000, "currency": "VND" } }] } }, "taxi"],
      "expect": { "summary": "Grab 约 15 分钟", "options": [{ "mode": "grab", "duration_min": 15, "note": "机场出口 B 门" }, { "mode": "taxi", "cost": { "amount": 200000, "currency": "VND" }, "recommended": true }] } },
    { "name": "导入过的：选一种没写过的，加在最前面", "args": [{ "id": "i1", "transport_in": { "options": [{ "mode": "grab", "recommended": true, "duration_min": 15 }] } }, "walk"],
      "expect": { "options": [{ "mode": "walk", "recommended": true, "source": "app" }, { "mode": "grab", "duration_min": 15 }] } },
    { "name": "导入过的：不允许「自动」，原样返回", "args": [{ "id": "i1", "transport_in": { "options": [{ "mode": "grab", "recommended": true }] } }, "auto"],
      "expect": { "options": [{ "mode": "grab", "recommended": true }] } },
    { "name": "导入过的、以前标过 auto：选了一种就去掉 auto", "args": [{ "id": "i1", "transport_in": { "auto": true, "options": [{ "mode": "grab", "recommended": true }] } }, "grab"],
      "expect": { "options": [{ "mode": "grab", "recommended": true }], "auto": null } },
    { "name": "有人接", "args": [{ "id": "i1" }, "transfer"], "expect": { "options": [{ "mode": "transfer", "recommended": true, "source": "app" }] } },
    { "name": "不认识的方式：报错", "args": [{ "id": "i1" }, "rocket"], "throws": "不认识的交通方式", "expect": null },

    { "fn": "transportOf", "name": "App 里点的（只有 App 写的那条）：appSet", "args": [{ "transport_in": { "options": [{ "mode": "taxi", "recommended": true, "source": "app" }] } }],
      "expect": { "mode": "taxi", "imported": false, "appSet": true } },
    { "fn": "transportOf", "name": "导入的、没在 App 里点过：不算 appSet", "args": [{ "transport_in": { "summary": "船 20 分钟", "options": [{ "mode": "ferry", "recommended": true }] } }],
      "expect": { "mode": "ferry", "imported": true, "appSet": false } },
    { "fn": "transportOf", "name": "导入的、在 App 里点过（picked）：appSet", "args": [{ "transport_in": { "picked": true, "options": [{ "mode": "ferry", "recommended": true }] } }],
      "expect": { "mode": "ferry", "imported": true, "appSet": true } },
    { "fn": "transportOf", "name": "读推荐的那种；也写了打车", "args": [{ "transport_in": { "options": [{ "mode": "walk", "recommended": true }, { "mode": "grab" }] } }],
      "expect": { "mode": "walk", "modes": ["walk", "grab"], "auto": false, "imported": true, "rideAlt": true } },
    { "fn": "transportOf", "name": "没推荐取第一种；只有 App 写的不算导入", "args": [{ "transport_in": { "options": [{ "mode": "metro", "source": "app" }] } }],
      "expect": { "mode": "metro", "imported": false, "rideAlt": false } },
    { "fn": "transportOf", "name": "auto: true 当没写", "args": [{ "transport_in": { "auto": true, "options": [{ "mode": "grab", "recommended": true }] } }],
      "expect": { "mode": null, "auto": true, "imported": true } },
    { "fn": "transportOf", "name": "兼容顶层 mode", "args": [{ "transport_in": { "mode": "subway" } }], "expect": { "mode": "subway", "modes": ["subway"] } },
    { "fn": "transportOf", "name": "只有一句 summary 也算导入", "args": [{ "transport_in": { "summary": "快线 2 小时", "options": [] } }], "expect": { "mode": null, "imported": true } },
    { "fn": "transportOf", "name": "没写", "args": [{}], "expect": { "mode": null, "modes": [], "imported": false } },

    { "fn": "transportChoices", "name": "没写：有「自动」，当前是自动", "args": [{}],
      "expect": { "current": "auto", "autoAllowed": true, "sub": null } },
    { "fn": "transportChoices", "name": "导入过的：没有「自动」，当前是推荐那种的芯片", "args": [{ "transport_in": { "options": [{ "mode": "hsr", "recommended": true, "duration_min": 90 }] } }],
      "expect": { "current": "transit", "autoAllowed": false, "sub": "hsr" } },
    { "fn": "transportChoices", "name": "App 写的摩托：芯片「骑车」", "args": [{ "transport_in": { "options": [{ "mode": "scooter", "recommended": true, "source": "app" }] } }],
      "expect": { "current": "bike", "autoAllowed": true } },

    { "fn": "chipOfMode", "name": "grab → 打车", "args": ["grab"], "expect": "ride" },
    { "fn": "chipOfMode", "name": "ferry → 地铁公交", "args": ["ferry"], "expect": "transit" },
    { "fn": "chipOfMode", "name": "car → 自驾", "args": ["car"], "expect": "self_drive" },
    { "fn": "chipOfMode", "name": "flight → 更多", "args": ["flight"], "expect": "more" },
    { "fn": "chipOfMode", "name": "transfer → 有人接", "args": ["transfer"], "expect": "transfer" },
    { "fn": "chipOfMode", "name": "没写 → 自动", "args": [null], "expect": "auto" },

    { "fn": "titleHow", "name": "开头「打车」", "args": ["打车回酒店", false], "expect": { "key": "ride", "mode": "taxi" } },
    { "fn": "titleHow", "name": "开头「叫 Uber」", "args": ["叫 Uber 去夜市", false], "expect": { "key": "ride" } },
    { "fn": "titleHow", "name": "不在开头的「Grab」不算", "args": ["可能叫 Grab 外卖", false], "expect": null },
    { "fn": "titleHow", "name": "交通条目在任意位置找", "args": ["可能叫 Grab 回去", true], "expect": { "key": "ride" } },
    { "fn": "titleHow", "name": "坐高铁", "args": ["坐高铁去南湾", false], "expect": { "key": "transit", "mode": "hsr" } },
    { "fn": "titleHow", "name": "乘缆车", "args": ["乘缆车上山", false], "expect": { "key": "transit", "mode": "cable_car" } },
    { "fn": "titleHow", "name": "搭机场快线（香港是铁路）", "args": ["搭机场快线", false], "expect": { "key": "transit", "mode": "train" } },
    { "fn": "titleHow", "name": "走 10 分钟", "args": ["走 10 分钟到海边", false], "expect": { "key": "walk" } },
    { "fn": "titleHow", "name": "普通标题", "args": ["午饭：海鲜", false], "expect": null },
    { "fn": "titleHow", "name": "交通条目「客运」", "args": ["南湾客运 9100", true], "expect": { "key": "transit", "mode": "bus" } },

    { "fn": "checkinWindow", "name": "值机窗口：48 小时前开、1 小时前关、待办截止 3 小时前", "args": ["2026-12-10T09:45:00+07:00"],
      "expect": { "opensAt": 1796697900000, "closesAt": 1796867100000, "dueAt": 1796859900000 } },
    { "fn": "checkinWindow", "name": "航司表给 24 小时开放", "args": ["2026-12-10T09:45:00+07:00", { "opens_h": 24 }],
      "expect": { "opensAt": 1796784300000 } },
    { "fn": "checkinWindow", "name": "没有起飞时间", "args": [null], "expect": null },
    { "fn": "kmText", "name": "公里写法：10 以内一位小数", "args": [3.249], "expect": "3.2" },
    { "fn": "kmText", "name": "公里写法：整数不带 .0", "args": [2.0], "expect": "2" },
    { "fn": "kmText", "name": "公里写法：10 以上取整", "args": [93.6], "expect": "94" }
  ]
}
