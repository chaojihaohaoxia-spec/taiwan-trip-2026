{
  "_说明": "币种写法（currency.js）的金标准。港币、人民币、新台币、越南盾、美元和 lib/money.js 一字不差。",
  "fn": "formatCurrency",
  "cases": [
    { "name": "日元写 JP¥（¥ 留给人民币）", "args": [1200, "JPY"], "expect": "JP¥1,200" },
    { "name": "韩元易读写法", "args": [15000, "KRW", { "readable": true }], "expect": "1.5 万韩元" },
    { "name": "韩元紧凑写法", "args": [15000, "KRW"], "expect": "₩15,000" },
    { "name": "泰铢", "args": [350, "THB"], "expect": "฿350" },
    { "name": "泰铢带小数", "args": [350.5, "THB"], "expect": "฿350.50" },
    { "name": "港币带小数", "args": [88.5, "HKD"], "expect": "HK$88.50" },
    { "name": "港币整数", "args": [88, "HKD"], "expect": "HK$88" },
    { "name": "人民币", "args": [300, "CNY"], "expect": "¥300" },
    { "name": "新台币不带小数", "args": [1234.6, "TWD"], "expect": "NT$1,235" },
    { "name": "越南盾", "args": [400000, "VND"], "expect": "400,000₫" },
    { "name": "越南盾易读", "args": [450000, "VND", { "readable": true }], "expect": "45 万越南盾" },
    { "name": "越南盾不到 1 万", "args": [5000, "VND", { "readable": true }], "expect": "5,000 越南盾" },
    { "name": "印尼盾易读", "args": [1250000, "IDR", { "readable": true }], "expect": "125 万印尼盾" },
    { "name": "一亿越南盾", "args": [123456789, "VND", { "readable": true }], "expect": "1.23 亿越南盾" },
    { "name": "欧元", "args": [12.5, "EUR"], "expect": "€12.50" },
    { "name": "瑞士法郎", "args": [20, "CHF"], "expect": "CHF 20" },
    { "name": "美元", "args": [9.99, "USD"], "expect": "US$9.99" },
    { "name": "负数", "args": [-88.5, "HKD"], "expect": "−HK$88.50" },
    { "name": "旧写法 NTD", "args": [100, "ntd"], "expect": "NT$100" },
    { "name": "不认识的币种", "args": [1000, "XYZ"], "expect": "XYZ 1,000" },
    { "name": "没有金额", "args": [null, "HKD"], "expect": "—" },
    { "fn": "currencyName", "name": "中文名", "args": ["KRW"], "expect": "韩元" },
    { "fn": "currencyName", "name": "中文名：不认识的原样", "args": ["XYZ"], "expect": "XYZ" },
    { "fn": "minorUnits", "name": "小数位：日元 0", "args": ["JPY"], "expect": 0 },
    { "fn": "minorUnits", "name": "小数位：泰铢 2", "args": ["THB"], "expect": 2 },
    { "fn": "minorUnits", "name": "小数位：不认识的 2", "args": ["XYZ"], "expect": 2 },
    { "fn": "formatWan", "name": "万：45.5 万", "args": [455000], "expect": "45.5 万" },
    { "fn": "formatWan", "name": "万：1.23 万", "args": [12345], "expect": "1.23 万" },
    { "fn": "formatWan", "name": "万：不加千分位", "args": [12345678], "expect": "1235 万" },
    { "fn": "groupDigits", "name": "千分位", "args": [1234567.891, 2], "expect": "1,234,567.89" }
  ]
}
