{
  "_说明": "prevStop 的金标准（演示数据）。dayItems 已按 sort_key 排好；places 是 id → 地点。",
  "fn": "prevStop",
  "places": {
    "p-hotel": { "id": "p-hotel", "name": "椰影湾酒店", "lat": 8.68, "lng": 106.606 },
    "p-cafe": { "id": "p-cafe", "name": "椰子咖啡", "lat": 8.679, "lng": 106.604 },
    "p-market": { "id": "p-market", "name": "椰影夜市", "lat": 8.6833, "lng": 106.6085 },
    "p-noodle": { "id": "p-noodle", "name": "清晨粉店" },
    "p-town": { "id": "p-town", "name": "椰影镇", "lat": 8.6833, "lng": 106.6085, "coord_precision": "city" },
    "p-north": { "id": "p-north", "name": "北滩", "lat": 8.71, "lng": 106.625 }
  },
  "cases": [
    { "name": "当天第一项：看昨晚住的地方", "itemId": "a1", "stayLastNight": "p-hotel",
      "dayItems": [{ "id": "a1", "place_id": "p-cafe" }, { "id": "a2", "place_id": "p-market" }],
      "expect": { "place": { "id": "p-hotel" }, "from": "stay", "itemId": null, "unknown": false } },
    { "name": "当天第一项又没住处：null", "itemId": "a1",
      "dayItems": [{ "id": "a1", "place_id": "p-cafe" }],
      "expect": null },
    { "name": "上一项有地点：就是它", "itemId": "a2", "stayLastNight": "p-hotel",
      "dayItems": [{ "id": "a1", "place_id": "p-cafe" }, { "id": "a2", "place_id": "p-market" }],
      "expect": { "place": { "id": "p-cafe" }, "from": "item", "itemId": "a1", "unknown": false } },
    { "name": "跳过没有地点的条目", "itemId": "a3",
      "dayItems": [{ "id": "a1", "place_id": "p-cafe" }, { "id": "a2", "title": "取现金" }, { "id": "a3", "place_id": "p-market" }],
      "expect": { "itemId": "a1" } },
    { "name": "跳过标了「没去」的", "itemId": "a3",
      "dayItems": [{ "id": "a1", "place_id": "p-cafe" }, { "id": "a2", "place_id": "p-north", "status": "skipped" }, { "id": "a3", "place_id": "p-market" }],
      "expect": { "itemId": "a1" } },
    { "name": "跳过删掉的", "itemId": "a3",
      "dayItems": [{ "id": "a1", "place_id": "p-cafe" }, { "id": "a2", "place_id": "p-north", "deleted_at": "2026-12-01T00:00:00Z" }, { "id": "a3", "place_id": "p-market" }],
      "expect": { "itemId": "a1" } },
    { "name": "做完了的照样算上一站", "itemId": "a2",
      "dayItems": [{ "id": "a1", "place_id": "p-north", "status": "done" }, { "id": "a2", "place_id": "p-market" }],
      "expect": { "itemId": "a1" } },
    { "name": "上一项有地点但没坐标：返回它，上一站不明（不越过它）", "itemId": "a3",
      "dayItems": [{ "id": "a1", "place_id": "p-cafe" }, { "id": "a2", "place_id": "p-noodle" }, { "id": "a3", "place_id": "p-market" }],
      "expect": { "itemId": "a2", "unknown": true } },
    { "name": "上一项坐标只到城市：也是上一站不明", "itemId": "a2",
      "dayItems": [{ "id": "a1", "place_id": "p-town" }, { "id": "a2", "place_id": "p-market" }],
      "expect": { "itemId": "a1", "unknown": true } },
    { "name": "备选方案：用它替代的主方案那一项的上一站", "itemId": "b1",
      "dayItems": [{ "id": "a1", "place_id": "p-cafe" }, { "id": "a2", "place_id": "p-north" }, { "id": "b1", "variant": "rain", "parent_item_id": "a2", "place_id": "p-market" }],
      "expect": { "itemId": "a1", "from": "item" } },
    { "name": "备选方案在主方案中间：不算别人的上一站", "itemId": "a3",
      "dayItems": [{ "id": "a1", "place_id": "p-cafe" }, { "id": "b1", "variant": "backup", "place_id": "p-north" }, { "id": "a3", "place_id": "p-market" }],
      "expect": { "itemId": "a1" } },
    { "name": "当天通用备选（没挂主方案）：null", "itemId": "b1", "stayLastNight": "p-hotel",
      "dayItems": [{ "id": "a1", "place_id": "p-cafe" }, { "id": "b1", "variant": "backup", "place_id": "p-market" }],
      "expect": null },
    { "name": "地点找不到（被删了）：跳过", "itemId": "a2", "stayLastNight": "p-hotel",
      "dayItems": [{ "id": "a1", "place_id": "p-gone" }, { "id": "a2", "place_id": "p-market" }],
      "expect": { "from": "stay" } },
    { "name": "条目不在这一天：null", "itemId": "zz",
      "dayItems": [{ "id": "a1", "place_id": "p-cafe" }],
      "expect": null }
  ]
}
