{
  "_说明": "坐标小工具（geo.js）的金标准。GCJ-02 的样例和常用的 coordtransform 实现对得上（北京 39.915, 116.404 → 39.9164043, 116.4102445）。",
  "fn": "haversineKm",
  "cases": [
    { "name": "直线距离：赤道附近经度差 1 度约 109.5 公里", "args": [{ "lat": 10, "lng": 100 }, { "lat": 10, "lng": 101 }], "expect": 109.50573519924353 },
    { "name": "直线距离：数组写法", "args": [[8.68, 106.606], [8.679, 106.604]], "expect": 0.24636444174738234 },
    { "name": "直线距离：一边没坐标 → null", "args": [{ "lat": 8.68, "lng": 106.6 }, { "lat": null, "lng": null }], "expect": null },
    { "name": "直线距离：(0,0) 当没坐标", "args": [{ "lat": 0, "lng": 0 }, { "lat": 8.68, "lng": 106.6 }], "expect": null },
    { "fn": "coordOf", "name": "能用的坐标：字符串数字也行", "args": [{ "lat": "8.68", "lng": "106.6" }], "expect": { "lat": 8.68, "lng": 106.6 } },
    { "fn": "coordOf", "name": "能用的坐标：只到城市的不算", "args": [{ "lat": 8.68, "lng": 106.6, "coord_precision": "city" }], "expect": null },
    { "fn": "coordOf", "name": "能用的坐标：大概位置算", "args": [{ "lat": 8.68, "lng": 106.6, "coord_precision": "approximate" }], "expect": { "lat": 8.68, "lng": 106.6 } },
    { "fn": "coordOf", "name": "能用的坐标：越界", "args": [{ "lat": 98, "lng": 106.6 }], "expect": null },
    { "fn": "coordOf", "name": "能用的坐标：空串", "args": [{ "lat": "", "lng": "" }], "expect": null },
    { "fn": "rawCoordOf", "name": "原始坐标：只到城市也给", "args": [{ "lat": 8.68, "lng": 106.6, "coord_precision": "city" }], "expect": { "lat": 8.68, "lng": 106.6 } },
    { "fn": "samePlace", "name": "同一个地方：同 id", "args": [{ "id": "a" }, { "id": "a" }], "expect": true },
    { "fn": "samePlace", "name": "同一个地方：40 米", "args": [{ "id": "a", "lat": 8.6833, "lng": 106.6085 }, { "id": "b", "lat": 8.6835, "lng": 106.6088 }], "expect": true },
    { "fn": "samePlace", "name": "不是同一个地方：120 米", "args": [{ "id": "a", "lat": 8.68, "lng": 106.606 }, { "id": "b", "lat": 8.681, "lng": 106.6065 }], "expect": false },
    { "fn": "samePlace", "name": "只到城市的坐标不比距离", "args": [{ "id": "a", "lat": 8.6833, "lng": 106.6085, "coord_precision": "city" }, { "id": "b", "lat": 8.6833, "lng": 106.6085 }], "expect": false },
    { "fn": "samePlace", "name": "自己给门槛：200 米内", "args": [{ "id": "a", "lat": 8.68, "lng": 106.606 }, { "id": "b", "lat": 8.681, "lng": 106.6065 }, 200], "expect": true },
    { "fn": "inBox", "name": "包围盒：在里面", "args": [{ "lat": 8.634, "lng": 106.608 }, [8.62, 106.59, 8.64, 106.62]], "expect": true },
    { "fn": "inBox", "name": "包围盒：在外面", "args": [{ "lat": 8.68, "lng": 106.608 }, [8.62, 106.59, 8.64, 106.62]], "expect": false },
    { "fn": "boxOf", "name": "一组点的包围盒（跳过没坐标的）", "args": [[{ "lat": 8.68, "lng": 106.606 }, { "lat": null, "lng": null }, [8.71, 106.625], { "lat": 8.656, "lng": 106.56 }]], "expect": [8.656, 106.56, 8.71, 106.625] },
    { "fn": "boxOf", "name": "没有合法点", "args": [[{ "lat": null }]], "expect": null },
    { "fn": "inPolygon", "name": "多边形：三角形里", "args": [{ "lat": 1, "lng": 1 }, [[0, 0], [0, 3], [3, 0]]], "expect": true },
    { "fn": "inPolygon", "name": "多边形：三角形外", "args": [{ "lat": 2, "lng": 2 }, [[0, 0], [0, 3], [3, 0]]], "expect": false },
    { "fn": "inMainland", "name": "内地：北京", "args": [39.915, 116.404], "expect": true },
    { "fn": "inMainland", "name": "内地：香港不算", "args": [22.3, 114.17], "expect": false },
    { "fn": "inMainland", "name": "内地：台北不算", "args": [25.03, 121.56], "expect": false },
    { "fn": "inMainland", "name": "内地：深圳福田算", "args": [22.54, 114.06], "expect": true },
    { "fn": "inMainland", "name": "内地：越南不算", "args": [8.68, 106.6], "expect": false },
    { "fn": "inMainland", "name": "内地：越南北部（下龙湾一带）不算", "args": [20.95, 107.08], "expect": false },
    { "fn": "inMainland", "name": "内地：首尔不算", "args": [37.57, 126.98], "expect": false },
    { "fn": "inMainland", "name": "内地：三亚算", "args": [18.25, 109.51], "expect": true },
    { "fn": "inMainland", "name": "内地：成都算", "args": [30.57, 104.07], "expect": true },
    { "fn": "inMainland", "name": "内地：乌鲁木齐算", "args": [43.83, 87.62], "expect": true },
    { "fn": "inMainland", "name": "内地：乌兰巴托不算", "args": [47.9, 106.9], "expect": false },
    { "fn": "wgs84ToGcj02", "name": "WGS-84 → GCJ-02：北京", "args": [39.915, 116.404], "expect": { "lat": 39.9164043, "lng": 116.4102445 } },
    { "fn": "wgs84ToGcj02", "name": "WGS-84 → GCJ-02：香港原样", "args": [22.3, 114.17], "expect": { "lat": 22.3, "lng": 114.17 } },
    { "fn": "wgs84ToGcj02", "name": "WGS-84 → GCJ-02：没坐标", "args": [null, null], "expect": null },
    { "fn": "gcj02ToWgs84", "name": "GCJ-02 → WGS-84：转回去误差不到 1 米", "args": [39.9164043, 116.4102445], "expect": { "lat": 39.915, "lng": 116.404 } },
    { "fn": "gcj02ToWgs84", "name": "GCJ-02 → WGS-84：台北原样", "args": [25.03, 121.56], "expect": { "lat": 25.03, "lng": 121.56 } }
  ]
}
