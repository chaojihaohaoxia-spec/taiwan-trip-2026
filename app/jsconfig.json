{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "checkJs": false,
    "allowJs": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "lucide-preact/icons/*": [
        "node_modules/lucide-preact/dist/esm/icons/*.mjs"
      ]
    }
  },
  "include": [
    "src",
    "demo",
    "scripts",
    "test"
  ],
  "exclude": [
    "node_modules"
  ]
}
